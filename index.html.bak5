    '词元': { text: m.lemma },
    '对应中文': { text: m.chWord },
    '使用义项': { text: m.sense || '' },
    '位置': { number: m.position || 0 },
    '所在句子': { text: m.sentence || '' },
    '手动修改': { checkbox: m.manual || false }
